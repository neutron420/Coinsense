# Database Configuration
# For local development, SQLite is used by default.
DATABASE_URL=sqlite:///./coinsense.db

# For PostgreSQL (optional, for production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coinsense_db
DB_USER=coinsense_user
DB_PASSWORD=your-database-password

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Keys (Replace with your actual keys)
COINGECKO_API_KEY="your-coingecko-api-key"
NEWS_API_KEY="your-newsapi-key"
COINMARKETCAP_API_KEY="your-coinmarketcap-api-key"
HUGGINGFACE_API_KEY="your-huggingface-api-key"

# Model Configuration (Paths are relative to the backend directory)
LSTM_MODEL_PATH=./trained_models
RAG_MODEL_PATH=./trained_models
SENTIMENT_MODEL_PATH=./trained_models

# Data Paths (Paths are relative to the backend directory)
CRYPTO_DATASET_PATH=../datasets/crypto_datasets/
COINS_DATA_PATH=../datasets/coins_datasets/

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Configuration
ALLOWED_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173"]'